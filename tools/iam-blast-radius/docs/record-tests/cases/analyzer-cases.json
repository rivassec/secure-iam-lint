{
  "schemaVersion": 1,
  "cases": [
    {
      "id": "BND-01",
      "family": "permissions-boundary",
      "input": {
        "Version": "2012-10-17",
        "Statement": [{
          "Sid": "MaximumPermissions",
          "Effect": "Allow",
          "Action": ["s3:*", "dynamodb:*"],
          "Resource": "*"
        }]
      },
      "expect": {
        "status": "COMPLETE",
        "requiredRuleIds": ["BOUNDARY-ENVELOPE"],
        "forbiddenRuleIds": ["WILDCARD-RESOURCE"],
        "requiredText": ["wildcard boundary provides no meaningful upper bound"],
        "capabilityEdges": 0
      }
    },
    {
      "id": "BND-02",
      "kind": "controlled-rendering-procedure",
      "procedure": "Render a controlled finding with ruleId WILDCARD-RESOURCE in boundary mode.",
      "expect": {"narrowForbiddenRuleAssertionFails": true}
    },
    {
      "id": "BND-03",
      "kind": "family-switch-procedure",
      "from": "identity",
      "to": "permissions-boundary",
      "expect": {"staleResults": 0, "forbiddenRuleIds": ["WILDCARD-RESOURCE"], "capabilityEdges": 0}
    },
    {
      "id": "BND-04",
      "kind": "family-switch-procedure",
      "from": "permissions-boundary",
      "to": "identity",
      "expect": {"staleResults": 0, "forbiddenRuleIds": ["BOUNDARY-ENVELOPE"]}
    },
    {
      "id": "BND-05",
      "kind": "family-switch-procedure",
      "from": "permissions-boundary",
      "to": "session",
      "expect": {"staleResults": 0, "capabilityEdges": 0}
    },
    {
      "id": "BND-06",
      "kind": "browser-matrix",
      "projects": ["chromium", "firefox", "webkit"],
      "cases": ["BND-01", "BND-02", "BND-03", "BND-04", "BND-05"],
      "expect": {"semanticParity": true}
    },
    {
      "id": "BND-07",
      "kind": "export-procedure",
      "formats": ["json", "markdown"],
      "expect": {"latestFamilyOnly": true, "browserExportParity": true}
    },
    {
      "id": "BND-08",
      "kind": "stale-state-procedure",
      "procedure": "Change family after completed analysis without reanalyzing.",
      "expect": {"resultsRemovedOrMarkedStale": true, "exportsDisabled": true}
    },
    {
      "id": "T91-01",
      "family": "identity",
      "context": {"subjectAccount": "123456789012", "partition": "aws"},
      "input": {
        "Version": "2012-10-17",
        "Statement": [
          {"Effect": "Allow", "Action": "iam:PassRole", "Resource": "arn:aws:iam::999900001111:role/ForeignRole"},
          {"Effect": "Allow", "Action": "ec2:RunInstances", "Resource": "*"}
        ]
      },
      "expect": {
        "forbiddenFindings": [{"ruleId": "PASSROLE-EC2", "severity": "critical"}],
        "requiredWarningCodes": ["PASSROLE_CROSS_ACCOUNT_INCOMPATIBLE"]
      }
    },
    {
      "id": "T91-02",
      "family": "identity",
      "context": {"subjectAccount": "123456789012", "partition": "aws"},
      "input": {
        "Version": "2012-10-17",
        "Statement": [
          {"Effect": "Allow", "Action": "iam:PassRole", "Resource": "arn:aws:iam::123456789012:role/LocalRole"},
          {"Effect": "Allow", "Action": "ec2:RunInstances", "Resource": "*"}
        ]
      },
      "expect": {"requiredFindings": [{"ruleId": "PASSROLE-EC2", "severity": "critical"}]}
    },
    {
      "id": "T91-03",
      "family": "identity",
      "context": {"subjectAccount": "123456789012", "partition": "aws"},
      "input": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Action": "iam:PassRole",
            "Resource": "arn:aws:iam::999900001111:role/ForeignRole",
            "Condition": {"StringEquals": {"iam:PassedToService": "ec2.amazonaws.com"}}
          },
          {"Effect": "Allow", "Action": "ec2:RunInstances", "Resource": "*"}
        ]
      },
      "expect": {"forbiddenFindings": [{"ruleId": "PASSROLE-EC2", "severity": "critical"}]}
    },
    {
      "id": "T91-04",
      "family": "identity",
      "context": {"subjectAccount": "123456789012", "partition": "aws"},
      "input": {
        "Version": "2012-10-17",
        "Statement": [
          {"Effect": "Allow", "Action": "iam:PassRole", "Resource": "arn:aws:iam::*:role/workloads/*"},
          {"Effect": "Allow", "Action": "ec2:RunInstances", "Resource": "*"}
        ]
      },
      "expect": {"requiredFindings": [{"ruleId": "PASSROLE-EC2", "severity": ["critical", "high"]}]}
    },
    {
      "id": "T91-05",
      "family": "identity",
      "context": {"subjectAccount": "123456789012", "partition": "aws"},
      "input": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Action": "iam:PassRole",
            "Resource": [
              "arn:aws:iam::123456789012:role/LocalRole",
              "arn:aws:iam::999900001111:role/ForeignRole"
            ]
          },
          {"Effect": "Allow", "Action": "ec2:RunInstances", "Resource": "*"}
        ]
      },
      "expect": {
        "requiredFindings": [{"ruleId": "PASSROLE-EC2", "targetResources": ["arn:aws:iam::123456789012:role/LocalRole"]}],
        "excludedTargets": ["arn:aws:iam::999900001111:role/ForeignRole"]
      }
    },
    {
      "id": "T91-06",
      "family": "identity",
      "context": {"subjectAccount": "123456789012", "partition": "aws"},
      "input": {
        "Version": "2012-10-17",
        "Statement": [
          {"Effect": "Allow", "Action": "iam:PassRole", "Resource": "arn:aws-us-gov:iam::123456789012:role/GovRole"},
          {"Effect": "Allow", "Action": "ec2:RunInstances", "Resource": "*"}
        ]
      },
      "expect": {"forbiddenFindings": [{"ruleId": "PASSROLE-EC2", "severity": "critical"}], "requiredWarningCodes": ["PARTITION_MISMATCH"]}
    },
    {
      "id": "T91-07",
      "family": "identity",
      "input": {
        "Version": "2012-10-17",
        "Statement": [
          {"Effect": "Allow", "Action": "iam:PassRole", "Resource": "arn:aws:iam::999900001111:role/RoleWithUnknownCompatibility"},
          {"Effect": "Allow", "Action": "ec2:RunInstances", "Resource": "*"}
        ]
      },
      "expect": {"maxPathExploitability": "low", "requiredUnknowns": ["subjectAccount"]}
    },
    {
      "id": "T91-08",
      "family": "identity",
      "context": {"subjectAccount": "123456789012", "partition": "aws"},
      "input": {
        "Version": "2012-10-17",
        "Statement": [
          {"Effect": "Allow", "Action": "iam:PassRole", "Resource": "arn:aws:iam::123456789012:role/LocalEc2Role"},
          {"Effect": "Allow", "Action": "ec2:RunInstances", "Resource": "*"},
          {"Effect": "Allow", "Action": "sts:AssumeRole", "Resource": "arn:aws:iam::999900001111:role/ForeignRole"}
        ]
      },
      "expect": {
        "requiredFindings": [{"ruleId": "PASSROLE-EC2", "targetResources": ["arn:aws:iam::123456789012:role/LocalEc2Role"]}],
        "forbiddenTargetCorrelations": ["arn:aws:iam::999900001111:role/ForeignRole"]
      }
    },
    {
      "id": "T91-09",
      "family": "identity",
      "context": {"subjectAccount": "123456789012", "partition": "aws"},
      "input": {
        "Version": "2012-10-17",
        "Statement": [
          {"Sid": "AllowPassRole", "Effect": "Allow", "Action": "iam:PassRole", "Resource": "*"},
          {"Sid": "DenyLocalRoles", "Effect": "Deny", "Action": "iam:PassRole", "Resource": "arn:aws:iam::123456789012:role/*"},
          {"Sid": "RunInstances", "Effect": "Allow", "Action": "ec2:RunInstances", "Resource": "*"}
        ]
      },
      "expect": {
        "forbiddenFindings": [{"ruleId": "PASSROLE-EC2", "severity": "critical"}],
        "reason": "The residual allowed PassRole scope is foreign-only and cannot be passed directly to same-account services."
      }
    },
    {
      "id": "DEF-01",
      "family": "resource",
      "resourceContext": {"type": "s3-bucket", "arn": "arn:aws:s3:::public"},
      "input": {
        "Version": "2012-10-17",
        "Statement": [{"Effect": "Allow", "Principal": "*", "Action": "s3:GetObject", "Resource": "arn:aws:s3:::public/*"}]
      },
      "expect": {"status": "BLOCKED", "errorCode": "UNSUPPORTED_POLICY_FAMILY", "graph": null}
    },
    {
      "id": "DEF-02",
      "family": "resource",
      "resourceContext": {"type": "sns-topic", "arn": "arn:aws:sns:us-west-2:123456789012:events"},
      "input": {
        "Version": "2012-10-17",
        "Statement": [{"Effect": "Allow", "Principal": {"Service": "events.amazonaws.com"}, "Action": "sns:Publish", "Resource": "arn:aws:sns:us-west-2:123456789012:events"}]
      },
      "expect": {"status": "BLOCKED", "errorCode": "UNSUPPORTED_POLICY_FAMILY", "graph": null}
    },
    {
      "id": "DEF-03",
      "family": "resource",
      "resourceContext": {"type": "kms-key", "arn": "arn:aws:kms:us-west-2:123456789012:key/example"},
      "input": {
        "Version": "2012-10-17",
        "Statement": [{"Effect": "Allow", "Principal": {"AWS": "arn:aws:iam::123456789012:root"}, "Action": "kms:*", "Resource": "*"}]
      },
      "expect": {"status": "BLOCKED", "errorCode": "UNSUPPORTED_POLICY_FAMILY", "graph": null}
    },
    {
      "id": "DEF-04",
      "family": "rcp",
      "input": {
        "Version": "2012-10-17",
        "Statement": [{"Effect": "Deny", "Principal": "*", "Action": "s3:*", "Resource": "*"}]
      },
      "expect": {"status": "BLOCKED", "errorCode": "UNSUPPORTED_POLICY_FAMILY", "graph": null}
    },
    {
      "id": "DEF-05",
      "family": "scp",
      "input": {
        "Version": "2012-10-17",
        "Statement": [{"Effect": "Allow", "NotAction": "iam:*", "Resource": "*"}]
      },
      "expect": {"status": "BLOCKED", "graph": null, "capabilityEdges": 0}
    },
    {
      "id": "DEF-06",
      "family": "trust",
      "input": {
        "Version": "2012-10-17",
        "Statement": [{"Effect": "Deny", "NotPrincipal": {"AWS": "arn:aws:iam::123456789012:role/BreakGlass"}, "Action": "sts:AssumeRole"}]
      },
      "expect": {"status": "BLOCKED", "errorCode": "UNSUPPORTED_OR_INVALID_NOTPRINCIPAL"}
    },
    {
      "id": "DEF-07",
      "family": "resource",
      "input": {
        "Version": "2012-10-17",
        "Statement": [{"Effect": "Deny", "NotPrincipal": {"AWS": "arn:aws:iam::123456789012:role/BreakGlass"}, "Action": "s3:*", "Resource": "*"}]
      },
      "expect": {"status": "BLOCKED", "graph": null}
    },
    {
      "id": "DEF-08",
      "family": "identity",
      "input": {
        "Version": "2012-10-17",
        "Statement": [
          {"Effect": "Allow", "Action": "s3:GetObject", "Resource": "arn:aws:s3:::private/*"},
          {"Effect": "Allow", "Principal": "*", "Action": "s3:GetObject", "Resource": "arn:aws:s3:::public/*"}
        ]
      },
      "expect": {"status": "BLOCKED", "errorCode": "MIXED_OR_INVALID_POLICY_FAMILY", "graph": null}
    },
    {
      "id": "DEF-09",
      "kind": "family-switch-procedure",
      "from": "resource",
      "to": "identity",
      "expect": {"unsupportedWarningCleared": true, "blockedGraphLeak": false}
    },
    {
      "id": "DEF-10",
      "kind": "blocked-export-procedure",
      "formats": ["json", "markdown"],
      "expect": {"status": "BLOCKED", "riskScore": null, "graph": null, "diagnosticsPresent": true}
    }
  ]
}

    {
      "id": "BND-01",
      "family": "permissions-boundary",
      "input": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Sid": "MaximumPermissions",
            "Effect": "Allow",
            "Action": [
              "s3:*",
              "dynamodb:*"
            ],
            "Resource": "*"
          }
        ]
      },
      "expect": {
        "status": "COMPLETE",
        "requiredRuleIds": [
          "BOUNDARY-ENVELOPE"
        ],
        "forbiddenRuleIds": [
          "WILDCARD-RESOURCE"
        ],
        "requiredText": [
          "wildcard boundary provides no meaningful upper bound"
        ],
        "capabilityEdges": 0
      }
    },
    {
      "id": "BND-02",
      "kind": "controlled-rendering-procedure",
      "procedure": "Render a controlled finding with ruleId WILDCARD-RESOURCE in boundary mode.",
      "expect": {
        "narrowForbiddenRuleAssertionFails": true
      }
    },
    {
      "id": "BND-03",
      "kind": "family-switch-procedure",
      "from": "identity",
      "to": "permissions-boundary",
      "expect": {
        "staleResults": 0,
        "forbiddenRuleIds": [
          "WILDCARD-RESOURCE"
        ],
        "capabilityEdges": 0
      }
    },

    {
      "id": "DEF-01",
      "family": "resource",
      "resourceContext": {
        "type": "s3-bucket",
        "arn": "arn:aws:s3:::public"
      },
      "input": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Principal": "*",
            "Action": "s3:GetObject",
            "Resource": "arn:aws:s3:::public/*"
          }
        ]
      },
      "expect": {
        "status": "COMPLETE_WITH_WARNINGS",
        "warningCode": "RESOURCE_ANALYSIS_INCOMPLETE",
        "capabilityEdges": 0,
        "resourceAccessEdges": 1,
        "resourceGraphOriginTypes": ["ExternalPrincipal"],
        "expectedRuleIds": ["PUBLIC-ACCESS"],
        "forbiddenRuleIds": [
          "WILDCARD-ACTION",
          "WILDCARD-RESOURCE",
          "DATA-EXFIL",
          "KMS-DECRYPT"
        ]
      },
      "note": "IAM-1202: Principal '*' on a resource policy is anonymous/public, so the resource evaluator emits a PUBLIC-ACCESS finding and the graph draws an anonymous ExternalPrincipal -> can-access-resource -> attached-resource edge (an identity capability edge count of 0 - the resource-access edge is not an identity capability edge). Coverage stays INCOMPLETE: the remaining resource families (confused-deputy, same-account, KMS, NotPrincipal) are IAM-1203..1206, so the absence of a finding still does NOT mean safe."
    },
    {
      "id": "DEF-02",
      "family": "resource",
      "resourceContext": {
        "type": "sns-topic",
        "arn": "arn:aws:sns:us-west-2:123456789012:events"
      },
      "input": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Principal": {
              "Service": "events.amazonaws.com"
            },
            "Action": "sns:Publish",
            "Resource": "arn:aws:sns:us-west-2:123456789012:events"
          }
        ]
      },
      "expect": {
        "status": "COMPLETE_WITH_WARNINGS",
        "warningCode": "RESOURCE_ANALYSIS_INCOMPLETE",
        "capabilityEdges": 0,
        "expectedRuleIds": [
          "RESOURCE-CONFUSED-DEPUTY"
        ],
        "resourceAccessEdges": 1,
        "resourceGraphOriginTypes": [
          "Service"
        ],
        "forbiddenRuleIds": [
          "WILDCARD-ACTION",
          "WILDCARD-RESOURCE",
          "DATA-EXFIL",
          "KMS-DECRYPT",
          "PUBLIC-ACCESS"
        ]
      },
      "note": "IAM-1203: an SNS topic policy granting the events.amazonaws.com service principal sns:Publish with NO source binding is a cross-service confused-deputy EXPOSURE (RESOURCE-CONFUSED-DEPUTY), NOT public write - the principal is a service, not '*'. The graph origin is the calling Service -> can-access-resource -> the attached SNS topic (not a capability edge, so capabilityEdges stays 0). Coverage stays INCOMPLETE (same-account / KMS / NotPrincipal families are IAM-1204..1206), so absence of a further finding is still not proven-safe."
    },

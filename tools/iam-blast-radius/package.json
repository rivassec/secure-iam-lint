{
  "name": "iam-blast-radius-dev",
  "version": "0.0.0",
  "private": true,
  "description": "Dev harness (tests/fixtures/CI) for the IAM Blast Radius static tool. Shipped code is vanilla ES-module JS under content/extra/tools/iam-blast-radius/.",
  "type": "module",
  "scripts": {
    "test": "node --test \"tests/**/*.test.js\"",
    "typecheck": "tsc --checkJs --noEmit --allowJs --target es2022 --module es2022 ../../content/tools/iam-blast-radius/engine/*.js",
    "gate:no-network": "! grep -rInE 'fetch\\(|XMLHttpRequest|WebSocket|EventSource|sendBeacon|import\\([\"'\\''`]https?:' ../../content/tools/iam-blast-radius/ || (echo 'NETWORK API FOUND' && exit 1)",
    "gate:no-unsafe-dom": "! grep -rInE 'innerHTML|outerHTML|insertAdjacentHTML|\\beval\\(|new Function|WebAssembly|data:(text|application)/javascript|eval:\\s*true' ../../content/tools/iam-blast-radius/ || (echo 'UNSAFE DOM/EVAL FOUND' && exit 1)",
    "gate:no-network:node": "! grep -rInE 'fetch\\(|XMLHttpRequest|WebSocket|EventSource|sendBeacon|import\\([\"'\\''`]https?:|[\"'\\''`](node:)?(http|https|http2|net|tls|dgram|dns|inspector)[\"'\\''`]' ../../cli/ ../../action/ || (echo 'NETWORK API FOUND (cli/action)' && exit 1)",
    "gate:no-unsafe:node": "! grep -rInE '\\beval\\(|new Function|WebAssembly|data:(text|application)/javascript|eval:\\s*true|innerHTML|outerHTML|insertAdjacentHTML|setTimeout\\(\\s*[\"'\\''`]|[\"'\\''`](node:)?(child_process|vm)[\"'\\''`]' ../../cli/ ../../action/ || (echo 'UNSAFE NODE API FOUND (cli/action)' && exit 1)",
    "e2e": "playwright test",
    "mutation": "stryker run"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@stryker-mutator/core": "8.7.1"
  },
  "comment:overrides": "Force PATCHED versions of dev-only transitive deps with known CVEs (the shipped package has zero runtime deps, so these never reach a consumer; we patch rather than ignore). ajv/babel/tmp were flagged by OSV; qs is pinned >=6.15.2 defensively so a future dep bump cannot downgrade it back into GHSA-q8mj-m7cp-5q26. tmp 0.0.33->0.2.x reaches only external-editor's interactive-editor prompt (never triggered in CI or non-interactive mutation runs).",
  "overrides": {
    "ajv": "^8.18.0",
    "@babel/core": "^7.29.6",
    "tmp": "^0.2.6",
    "qs": "^6.15.2"
  }
}

{
  "name": "Acceptance test 17 - over-broad GitHub Actions OIDC trust (role-trust, supported)",
  "note": "IAM-801: role-trust is supported. A federated OIDC trust whose subject scope is org-wide (repo:example-org/*) is broad -> HIGH TRUST-FEDERATED. The audience (aud) check is recognized as a valid constraint. The finding recommends constraining sub to a repository + branch/environment and does NOT claim every repository can assume the role (that needs the matching token + workflow context, which is out of scope). The role's permissions remain unknown.",
  "phase": 8,
  "story": "IAM-801",
  "acceptanceTest": 17,
  "family": "role-trust",
  "policy": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Sid": "GitHubOIDC",
        "Effect": "Allow",
        "Principal": { "Federated": "arn:aws:iam::123456789012:oidc-provider/token.actions.githubusercontent.com" },
        "Action": "sts:AssumeRoleWithWebIdentity",
        "Condition": {
          "StringEquals": { "token.actions.githubusercontent.com:aud": "sts.amazonaws.com" },
          "StringLike": { "token.actions.githubusercontent.com:sub": "repo:example-org/*" }
        }
      }
    ]
  },
  "expect": {
    "valid": true,
    "findingIds": ["TRUST-FEDERATED"],
    "notFindingIds": ["ASSUME-ROLE-EXPANSION", "TRUST-PUBLIC"]
  },
  "coverageExpect": {
    "blocked": false,
    "detectedFamily": "role-trust"
  },
  "severityExpect": {
    "findingId": "TRUST-FEDERATED",
    "severityOneOf": ["high"],
    "policyEvidence": "high",
    "pathExploitabilityOneOf": ["medium", "high"]
  },
  "graphExpect": {
    "include": [
      { "type": "can-assume", "from": "ext:arn:aws:iam::123456789012:oidc-provider/token.actions.githubusercontent.com", "to": "role:trust-target" }
    ],
    "exclude": [
      { "type": "can-write" },
      { "type": "can-read" },
      { "from": "principal" }
    ]
  }
}

{
  "name": "Acceptance test 1 - cross-statement PassRole to EC2",
  "note": "IAM-701 provenance: iam:PassRole (statement 0) and ec2:RunInstances (statement 1) are distributed across statements. The header, evidence[], and graph edges must attribute each action ONLY to its granting statement - no synthetic statement may claim both.",
  "phase": 7,
  "story": "IAM-701",
  "acceptanceTest": 1,
  "family": "identity",
  "policy": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Sid": "PassWorkloadRoles",
        "Effect": "Allow",
        "Action": "iam:PassRole",
        "Resource": "arn:aws:iam::123456789012:role/workload/*"
      },
      {
        "Sid": "LaunchInstances",
        "Effect": "Allow",
        "Action": "ec2:RunInstances",
        "Resource": "*"
      }
    ]
  },
  "expect": {
    "valid": true,
    "findingIds": ["PASSROLE-EC2"],
    "notFindingIds": ["PASSROLE-LAMBDA"]
  },
  "provenanceExpect": {
    "focusFindingId": "PASSROLE-EC2",
    "crossStatement": true,
    "contributingStatements": [
      { "statementIndex": 0, "statementSid": "PassWorkloadRoles", "actions": ["iam:PassRole"] },
      { "statementIndex": 1, "statementSid": "LaunchInstances", "actions": ["ec2:RunInstances"] }
    ],
    "graphEdges": [
      { "from": "principal", "to": "role:passable:ec2", "type": "can-pass", "statementIndex": 0, "actions": ["iam:PassRole"] },
      { "from": "role:passable:ec2", "to": "service:ec2", "type": "can-execute-as", "statementIndex": 1, "actions": ["ec2:RunInstances"] }
    ]
  }
}

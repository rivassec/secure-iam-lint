{
  "name": "Acceptance test 18 - normal AWS service trust (role-trust negative control, supported)",
  "note": "IAM-801: role-trust is supported. This is the negative control: a benign lambda.amazonaws.com service trust yields at most an INFORMATIONAL TRUST-SERVICE relationship - no public/external-account finding and no escalation path, and NEVER an inference about the role's permissions from the trust policy alone.",
  "phase": 8,
  "story": "IAM-801",
  "acceptanceTest": 18,
  "family": "role-trust",
  "policy": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Sid": "LambdaServiceTrust",
        "Effect": "Allow",
        "Principal": { "Service": "lambda.amazonaws.com" },
        "Action": "sts:AssumeRole"
      }
    ]
  },
  "expect": {
    "valid": true,
    "findingIds": ["TRUST-SERVICE"],
    "notFindingIds": ["ASSUME-ROLE-EXPANSION", "PASSROLE-LAMBDA", "TRUST-PUBLIC", "TRUST-CROSS-ACCOUNT"]
  },
  "coverageExpect": {
    "blocked": false,
    "detectedFamily": "role-trust"
  },
  "severityExpect": {
    "findingId": "TRUST-SERVICE",
    "severityOneOf": ["info"],
    "policyEvidence": "high",
    "pathExploitabilityOneOf": ["low", "medium"]
  },
  "graphExpect": {
    "include": [
      { "type": "can-assume", "from": "svc:lambda.amazonaws.com", "to": "role:trust-target" }
    ],
    "exclude": [
      { "type": "can-write" },
      { "type": "can-read" },
      { "from": "principal" }
    ]
  }
}

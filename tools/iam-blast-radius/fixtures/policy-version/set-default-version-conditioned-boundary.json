{
  "name": "SetDefaultPolicyVersion gated by a Condition (boundary)",
  "note": "Path still present but Condition-gated, so it is flagged with reduced confidence, not suppressed.",
  "policy": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Sid": "SetDefaultGated",
        "Effect": "Allow",
        "Action": "iam:SetDefaultPolicyVersion",
        "Resource": "arn:aws:iam::111122223333:policy/team-baseline",
        "Condition": { "Bool": { "aws:MultiFactorAuthPresent": "true" } }
      }
    ]
  },
  "expect": { "valid": true, "findingIds": ["POLICY-VERSION"], "notFindingIds": [] }
}

{
  "name": "load balancer and interface reads do not trip TRAFFIC-ROUTING (negative)",
  "policy": {
    "Version": "2012-10-17",
    "Statement": [
      { "Sid": "Reads", "Effect": "Allow", "Action": ["elasticloadbalancing:DescribeLoadBalancers", "events:DescribeRule"], "Resource": "arn:aws:events:us-east-2:123456789012:rule/orders" }
    ]
  },
  "expect": { "valid": true, "notFindingIds": ["TRAFFIC-ROUTING"] }
}

{
  "id": "suite2-test-53-mismatched-sourcearn-and-sourceaccount",
  "suite2Test": 53,
  "title": "Mismatched SourceArn and SourceAccount",
  "designBlocked": "Resource-based / RCP policy family tranche (post-Phase-5 family model). Flip to this test's Expected-result finding when a resource-policy (and RCP) evaluator ships; until then the engine fails closed rather than misread the document as an identity policy.",
  "expect": {
    "deferred": "blocked-by-design",
    "familyBlocked": true,
    "ok": true,
    "detectedFamily": "resource",
    "blockingCode": "UNSUPPORTED_POLICY_FAMILY",
    "noFindings": true
  },
  "policy": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Sid": "CloudTrailWriteWithMismatchedAccounts",
        "Effect": "Allow",
        "Principal": {
          "Service": "cloudtrail.amazonaws.com"
        },
        "Action": "s3:PutObject",
        "Resource": "arn:aws:s3:::central-cloudtrail/AWSLogs/111122223333/*",
        "Condition": {
          "StringEquals": {
            "aws:SourceAccount": "111122223333"
          },
          "ArnLike": {
            "aws:SourceArn": "arn:aws:cloudtrail:*:444455556666:trail/*"
          }
        }
      }
    ]
  }
}

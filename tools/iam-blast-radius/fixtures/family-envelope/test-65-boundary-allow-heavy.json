  "envelopeExpect": {
    "ok": true,
    "blocked": false,
    "family": "permissions-boundary",
    "override": "permissions-boundary",
    "status": "ok",
    "findingIds": [
      "PERMISSIONS-BOUNDARY-ENVELOPE"
    ],
    "severities": {
      "PERMISSIONS-BOUNDARY-ENVELOPE": "high"
    },
    "zeroCapabilityEdges": true,

{
  "id": "suite3-test-66-session-policy-selected",
  "suite3Test": 66,
  "title": "Session policy selected",
  "note": "IAM-1002 / suite-3 test 66: under an explicit Session selection, report a session ceiling with no positive capability edge unless the parent role/identity context is also supplied. Do not silently relabel the family as Identity because the document is byte-compatible.",
  "policy": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Effect": "Allow",
        "Action": "s3:GetObject",
        "Resource": "arn:aws:s3:::incident-evidence/*"
      }
    ]
  },
  "options": {
    "family": "session",
    "requireExplicitFamily": true
  },
  "envelopeExpect": {
    "ok": true,
    "blocked": false,
    "family": "session",
    "override": "session",
    "status": "ok",
    "findingIds": [
      "SESSION-CEILING"
    ],
    "severities": {
      "SESSION-CEILING": "info"
    },
    "zeroCapabilityEdges": true,
    "noEscalation": true,
    "statesIntersection": true,
    "differsFromIdentity": true
  }
}

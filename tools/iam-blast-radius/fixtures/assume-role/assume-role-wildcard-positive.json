{
  "name": "Broad sts:AssumeRole over a wildcard role scope (escalation)",
  "note": "sts:AssumeRole on Resource '*' lets the principal assume many roles; target-role permissions are unknown and never inferred.",
  "policy": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Sid": "AssumeAnything",
        "Effect": "Allow",
        "Action": "sts:AssumeRole",
        "Resource": "*"
      }
    ]
  },
  "expect": {
    "valid": true,
    "findingIds": ["ASSUME-ROLE-EXPANSION"],
    "notFindingIds": ["TRUST-POLICY-MODIFY"],
    "summary": {
      "counts": { "privEscPaths": 0, "roleAssumption": 1, "sensitiveData": 0, "broadResource": 1 },
      "highestRisk": { "id": "ASSUME-ROLE-EXPANSION", "severity": "critical", "path": "Principal -> sts:AssumeRole -> assumed role (unknown privileges)" }
    }
  }
}

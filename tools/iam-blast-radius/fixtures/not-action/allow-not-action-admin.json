{
  "name": "Allow NotAction (everything except IAM)",
  "note": "Classic NotAction pattern: grants all actions except iam:*. Parser must place the value in notActions and leave actions empty.",
  "policy": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Sid": "AllowAllExceptIam",
        "Effect": "Allow",
        "NotAction": "iam:*",
        "Resource": "*"
      }
    ]
  },

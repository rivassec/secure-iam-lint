          "resources": ["*"],
          "notResources": [],
          "condition": null,
          "principal": null,
          "notPrincipal": null
        }
      ]
    },
    "decide": [
      { "action": "s3:GetObject", "resource": "*", "decision": "allowed-by-policy" },
      { "action": "ec2:RunInstances", "resource": "*", "decision": "allowed-by-policy" },

{
  "id": "test-120",
  "suite4Test": 120,
  "story": "IAM-1404",
  "name": "SNS '*' narrowed by aws:PrincipalOrgID publish (near-miss)",
  "note": "acceptance-suite-4 test 120. A Principal '*' sns:Publish narrowed by StringEquals aws:PrincipalOrgID is the org-scoped publish pattern: the generic PUBLIC-ACCESS finding is HIGH (narrowed by a principal condition), NOT critical anonymous public. MESSAGING-PUBLIC-EXPOSURE must NOT fire (the '*' is scoped to authenticated org principals, not anonymous).",
  "options": {
    "family": "resource",
    "requireExplicitFamily": true,
    "resourceContext": { "type": "sns", "arn": "arn:aws:sns:us-east-2:444455556666:MyTopic" }
  },
  "policy": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Effect": "Allow",
        "Principal": { "AWS": "*" },
        "Action": "sns:Publish",
        "Resource": "arn:aws:sns:us-east-2:444455556666:MyTopic",
        "Condition": { "StringEquals": { "aws:PrincipalOrgID": "o-myorg" } }
      }
    ]
  },
  "expect": { "valid": true },
  "expectMessaging": {
    "coverageIncomplete": false,
    "findingIds": ["RESOURCE-CROSS-ACCOUNT"],
    "findingSeverities": { "RESOURCE-CROSS-ACCOUNT": "high" },
    "notCritical": ["RESOURCE-CROSS-ACCOUNT"],
    "notFindingIds": ["MESSAGING-PUBLIC-EXPOSURE", "MESSAGING-POLICY-TAKEOVER", "PUBLIC-ACCESS", "RESOURCE-CONFUSED-DEPUTY"],
    "scopedBy": { "RESOURCE-CROSS-ACCOUNT": ["aws:PrincipalOrgID"] },
    "whyIncludes": { "RESOURCE-CROSS-ACCOUNT": ["NARROWED", "aws:PrincipalOrgID"] },
    "forbidWhy": { "RESOURCE-CROSS-ACCOUNT": ["anyone can", "grants public access to anonymous"] }
  }
}

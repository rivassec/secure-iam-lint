{
  "name": "Full admin wildcard",
  "note": "Action * on Resource * - classic over-permission. Action \"*\" grants EVERY action, so it is de-facto AdministratorAccess and necessarily contains every privilege-escalation path the engine models: iam:PassRole + each service-execution action (critical compound paths), sts:AssumeRole over all roles (critical), and every direct-IAM self-administration primitive (high). The escalation engine must surface these rather than report zero escalation paths for full admin (threat-model T8: understating blast radius is as harmful as overstating it). The WILDCARD-ACTION \"*\" row grants strictly more than any single path, so it stays an independent top-level finding and is never folded into a compound path; the WILDCARD-RESOURCE \"*\" grant on the same statement is a scope risk factor of the compound paths and is subsumed (IAM-105).",
  "policy": {
    "Version": "2012-10-17",
    "Statement": [ { "Sid": "GodMode", "Effect": "Allow", "Action": "*", "Resource": "*" } ]
  },
  "expect": {
    "valid": true,
    "exactFindingIds": ["WILDCARD-ACTION", "WILDCARD-RESOURCE"],
    "findingIds": [
      "WILDCARD-ACTION",
      "PASSROLE-LAMBDA",
      "PASSROLE-EC2",
      "PASSROLE-SERVICE",
      "ASSUME-ROLE-EXPANSION",
      "ATTACH-POLICY",
      "PUT-INLINE-POLICY",
      "POLICY-VERSION",
      "TRUST-POLICY-MODIFY",
      "CREDENTIAL-CREATION"
    ],
    "notFindingIds": [],
    "compound": {
      "primaryId": "PASSROLE-LAMBDA",
      "subsumes": [{ "id": "WILDCARD-RESOURCE", "statementIndex": 0 }],
      "independentFindings": [{ "id": "WILDCARD-ACTION", "statementIndex": 0 }],
      "note": "Action \"*\" grants iam:PassRole + lambda:CreateFunction (among everything else), so PASSROLE-LAMBDA is a compound path anchored on statement 0. The WILDCARD-RESOURCE \"*\" grant on the same statement is a scope risk factor of that path and is subsumed. The WILDCARD-ACTION \"*\" grant is strictly broader than the path (it grants every action, not just the path's) and must remain an independent top-level row.",
      "riskFactors": [
        { "key": "pass-role", "present": true },
        { "key": "pass-role-resource-wildcard", "present": true },
        { "key": "exec-resource-wildcard", "present": true },
        { "key": "passed-to-service-restriction", "present": false }
      ]
    },
    "summary": {

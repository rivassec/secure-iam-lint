{
  "name": "Over-cap single Resource string: one token past LIMITS.MAX_STRING_LENGTH",
  "note": "One Resource string is 2115 characters, past the per-string cap LIMITS.MAX_STRING_LENGTH (2048). MAX_BYTES (a whole-document cap) alone would ACCEPT this - the document is tiny - yet a single multi-KB Action/Resource token is exactly the input the wildcard matcher does the most work on (threat-model T5). validate() must reject it with STRING_TOO_LONG BEFORE analysis, so analyze() returns ok:false and the CLI/Action fail CLOSED (exit 3), never a clean pass. This is the per-string companion to oversized-statements.json (whole-count cap).",
  "policy": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Sid": "OverCapResource",
        "Effect": "Allow",
        "Action": "s3:GetObject",
        "Resource": "arn:aws:s3:::*"
      }
    ]
  },
  "overCapExpect": {
    "validateError": "STRING_TOO_LONG",
    "analyzeOk": false,
    "nonZeroExit": true,
    "exitCode": 3
  }
}

{
  "Version": "2012-10-17",
  "Statement": [
    { "Sid": "BroadAndExplicit", "Effect": "Allow", "Action": ["s3:GetObject", "s3:ListBucket"], "Resource": ["*", "arn:aws:s3:::acme-competitor-bucket/*"] },
    { "Sid": "FenceGetOnly", "Effect": "Deny", "Action": "s3:GetObject", "NotResource": "arn:aws:s3:::acme-competitor-bucket/*" }
  ]
}
